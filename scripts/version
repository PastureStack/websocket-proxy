#!/bin/bash

is_numeric_version()
{
    [[ "$1" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

if [ -n "${VERSION_OVERRIDE:-}" ]; then
	if ! is_numeric_version "$VERSION_OVERRIDE"; then
		echo "VERSION_OVERRIDE must be a numeric semantic version" >&2
		exit 1
	fi
	VERSION=${VERSION_OVERRIDE#v}
else
	VERSION="0.23.16"
fi
